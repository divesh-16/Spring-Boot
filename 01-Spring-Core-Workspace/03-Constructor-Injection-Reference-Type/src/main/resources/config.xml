<?xml version="1.0" encoding="UTF-8"?>
<beans xmlns="http://www.springframework.org/schema/beans"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="
        http://www.springframework.org/schema/beans http://www.springframework.org/schema/beans/spring-beans.xsd">

    <!-- bean definitions here -->
    
    <bean id="addr" class="com.tca.beans.Address">
    	<constructor-arg  name="pincode" value="411007" />
    	<constructor-arg  name="city" value="Aundh" />
    </bean>
    
    <bean id="customer" class="com.tca.beans.Customer">
    	<constructor-arg  name="customerId" value="1001" />
    	<constructor-arg  name="customerName" value="AAAA" />
    	<constructor-arg  name="address" ref="addr" />
    </bean>
    
</beans>